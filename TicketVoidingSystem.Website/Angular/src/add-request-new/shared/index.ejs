@{
Layout = "~/Views/Shared/_LayoutAngular.cshtml";
var isEditMode = Context.Request.Path.Value?.ToLower().Contains("/edit/") == true;
ViewBag.Title = isEditMode ? "Edit Request Ticket Voiding" : "Add Request Ticket Voiding";
}
@section Head {
<% files.css.forEach(function(css){ %>
<link href="<%= css%>" rel="stylesheet" />
<% }) %>
}
<script>
    window.issueTypeId = '@(ViewBag.IssueTypeId?.ToString() ?? "")';
    window.isEdit = '@isEditMode';
</script>
<app-root></app-root>
<% files.js.forEach(function(js){ %>
<script src="<%= js%>"></script>
<% }) %>

