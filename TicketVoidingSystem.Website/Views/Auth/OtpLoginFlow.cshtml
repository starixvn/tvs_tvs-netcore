@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="/">
    <meta charset="utf-8" />
    <title>OTP</title>
    <meta name="viewport" content="width=device-width" />
    <link href="/nap-auth/auth.css" rel="stylesheet" type="text/css" />
    <link href="/nap-auth/otp.css" rel="stylesheet" type="text/css" />
</head>
<body>    
    @{
        var message = ViewBag.Message == null ? string.Empty : ViewBag.Message.ToString();
        var messageDisplayStyle = string.IsNullOrEmpty(message) ? "display:none" : "display:block";
    }
    <div class="center">
        <form action="/Auth/OtpLoginFlow" id="login-form" method="post">
            <div id="login-box">
                <div id="msg" style="@messageDisplayStyle">
                    <span id="inner-msg">@message</span>
                </div>
                <div class="header">
                    <div class="welcome">
                    </div>
                    <div class="secure">
                    </div>
                </div>
                <div class="auth">
                    <input type="text" id="otp" name="otp" class="otp" autocomplete="off" />
                    <input type="button" id="btnCancel" value="CANCEL" class="submit" onclick="location.href = 'Auth'" />
                    <input type="submit" id="btnSubmit" value="ENTER OTP" class="submit" />
                    <div class="bestview" style="height:8px">                        
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>