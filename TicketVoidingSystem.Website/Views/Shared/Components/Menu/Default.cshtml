@model IEnumerable<Fanex.NAP.Client.Models.MenuItem>

@if (Model != null)
{
    var menuItems = Model.Where(i => i.ParentId <= 0).OrderBy(i => i.DisplayOrder).ToList();

    <nav class="">
        <ul class="menu">
            @for (var i = 0; i < menuItems.Count; i++)
            {
                var menuItem = menuItems[i];
                var item = Model.Where(x => x.ParentId > 0 && x.ParentId == menuItem.Id).OrderBy(x => x.DisplayOrder).ToList();
                var className = "normal";

                if (i == 0)
                {
                    className = " first";
                }
                if (i == menuItems.Count - 1 && i > 0)
                {
                    className = className.Length > 0 ? " last" : "last";
                }
                if (item.Count == 0)
                {
                    var menuUrl =  Url.Content("~" + menuItem.Url);
                    <li class="@className"><a href="@menuUrl">@menuItem.Name</a></li>
                }
                else
                {
                    className += className.Length > 0 ? " has-kids" : "has-kids";
                    <li class="@className">
                        <a id="@(menuItem.Name.Replace(" ", string.Empty))-menu">@menuItem.Name</a>
                        <ul>
                            @foreach (var subMenuItem in item)
                            {
                                var menuUrl = Url.Content("~" + subMenuItem.Url);

                                <li><a href="@menuUrl">@subMenuItem.Name</a></li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    </nav>
}