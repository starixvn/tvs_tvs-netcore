@using TicketVoidingSystem.Constants
@using SpecialDelete.VoidByBetId.Constants
@model SpecialDelete.VoidByBetId.ViewModels.IndexViewModel

<ul class="tabs">
    <li id="label-tab-by-betid"><a href="#tab-by-betid">By Bet ID</a></li>
    @* <li id="label-tab-by-username"><a href="#tab-by-username">By Username</a></li> *@
</ul>

<div class="tab-container">
    <div id="tab-by-betid" class="tab-content">
        <div class="filter-bar">
            @if (Model.IsShowWarning)
            {
                <div class="note-filter-bar">
                    <em class="icon-warning"></em>
                    @Model.Remark
                </div>
            }
            <div class="clear-fix">
            </div>
            <div class="display-flex">
                <div class="filter-bar-inner">
                    <div class="filter-row">
                        <div class="filter-cell  tick-list">
                            <div class="lbl-field span3">
                                <label>BetID(s)</label>
                            </div>
                            <div class="filter-cell">
                                <div class="edit-field span8" style="width: 670px;">
                                    <div class="span6 offset number-group" id="number-group" style="width: 670px; max-height: 478px; overflow: auto;">
                                        <form autocomplete="off"><input id="txtTransId" class="text-number" autofocus /></form>
                                    </div>
                                    <span></span>
                                    <div class="float-left">
                                        <p id="errorBetId" style="margin-top: -22px;">
                                        </p>
                                        <br />
                                        Ex: 1234567890, 1223457890, 2234567890
                                    </div>
                                    <div class="float-right em">
                                        <p style="margin-top: 5px;">Max: 2000 bets</p>
                                    </div>
                                </div>
                            </div>
                            <input type="button" id="" class="btn btn-danger btn-remove-invalid" value="Remove Invalid" />
                        </div>
                    </div>
                    <div class="filter-row">
	                    <div class="abnormal-bet">
                            <label class="ckbox-abnormal-bet">
                                <input id="ckbox-abnormal-bet" type="checkbox" />
                                Abnormal Bet
                            </label>
                            <div class="radio-abnormal-bet" id="radio-abnormal-bet">
                                <label class="radio-abnormal-bet-single">
                                    <input id="radio-abnormal-bet-single" type="radio" checked value="0" name="abnormal-bet-type" />
                                    Single
                                </label>
                                <label class="radio-abnormal-bet-parlay">
                                    <input id="radio-abnormal-bet-parlay" type="radio" value="1" name="abnormal-bet-type" />
                                    Main Parlay
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="filter-row">
                        <div class="include-parlay">
                            <label class="ckbox-include-parlay">
                                <input id="ckbox-include-parlay" type="checkbox" />
                                Include Main Parlay (Sportsbook, Virtual Sports and Bet Builder)
                            </label>
                        </div>
                    </div>
                    <div class="filter-row">
                        <div class="filter-cell">
                            <input type="button" id="" class="submit btn-search" value="Search" />
                        </div>
                    </div>
                </div>
                <div class="affected-licensees display-none" id="affected-licensees">
                    <span class="note">Attn: system will notify affected tickets to these Licensee(s): </span>
                    <br />
                    <span class="affected-licensees-highlight" id="affected-licensees-highlight"></span>
                </div>
            </div>
        </div>
    </div>
    <div id="tab-by-username" class="tab-content">
        <div class="filter-bar">
            @if (Model.IsShowWarning)
            {
                <div class="note-filter-bar">
                    <em class="icon-warning"></em>
                    @Model.Remark.Replace(", Bet Builder and Saba Promotion", " and Bet Builder")
                </div>
            }
            <div class="clear-fix">
            </div>
            <div class="display-flex">
                <div class="filter-bar-inner">
                    <div class="filter-row">
                        <div class="filter-cell tick-list">
                            <div class="lbl-field span3">
                                <label>
                                    Username
                                </label>
                            </div>
                            <div class="edit-field span5">
                                <input type="text" id="txt-username" maxlength="30" value=""
                                       class="width-140" />
                            </div>
                        </div>
                        <div class="filter-cell">
                            <div class="edit-field datetime">
                                <div class="lbl-field span">
                                    <label for="from-date">Date From</label>
                                </div>
                                <div class="edit-field span4">
                                    @Html.TextBox("from-date", string.Empty, new { @readonly = "readonly", @class = "txt-calendar width-90" })
                                    <em class="icon-calendar icon-from-transdate-calendar"></em>
                                </div>
                                <div class="lbl-field span">
                                    <label for="to-date">To</label>
                                </div>
                                <div class="edit-field span5">
                                    @Html.TextBox("to-date", string.Empty, new { @class = "txt-calendar width-90" })
                                    <em class="icon-calendar icon-to-transdate-calendar"></em>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="filter-row selection-area">
                        <div class="products">
                            <label class="span3">
                                Products
                            </label>

                            <select id="product-select" multiple="multiple">
                                <option value="@ProductsConstant.Sportsbook" selected>Sportsbook</option>
                                <option value="@ProductsConstant.Parlay" selected>Parlay</option>
                                <option value="@ProductsConstant.BetBuilder" selected>Bet Builder</option>
                                <option value="@ProductsConstant.Outright" selected>Outright</option>
                                <option value="@ProductsConstant.Saba" selected>Saba</option>
                                <option value="@ProductsConstant.NonSports" selected>Non-Sports</option>
                            </select>
                        </div>
                        <div class="ticket-status">
                            <label class="span3">
                                Ticket status
                            </label>

                            <select id="ticket-status-select" multiple>
                                <option value="@TicketStatus.RunningId,@TicketStatus.WaitingId" selected>Running</option>
                                <option value="@TicketStatus.WonId" selected>Won</option>
                                <option value="@TicketStatus.LoseId" selected>Lose</option>
                                <option value="@TicketStatus.DrawId" selected>Draw</option>
                            </select>
                        </div>
                    </div>
                    <div class="filter-row">
                        <div class="filter-cell">
                            <input type="button" id="" class="submit btn-search" value="Search" />
                        </div>
                    </div>
                </div>
                <div class="affected-licensees display-none" id="affected-licensees">
                    <span class="note">Attn: system will notify affected tickets to these Licensee(s): </span>
                    <br />
                    <span class="affected-licensees-highlight" id="affected-licensees-highlight"></span>
                </div>
            </div>
        </div>
    </div>
</div>