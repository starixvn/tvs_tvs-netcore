@addTagHelper *, WebOptimizer.Core
@using Fanex.NAP.Client.Session
@using TicketVoidingSystem.Website.ViewComponents
@{
    var session = new NapSession(httpContextAccessor);
    var userName = User.Identity?.Name;
    var userId = session.UserId;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <base href="@Url.Content("~/")" />
        <meta charset="utf-8" />
        <title>@ViewBag.Title &mdash; NAP Special Delete</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="shortcut icon" href="~/favicon.ico" />
        <link rel="stylesheet" href="~/old-page/bundle/layout-libs.css" />
        @await RenderSectionAsync("Head", false)
        @if (IsSectionDefined("Styles"))
        {
            @await RenderSectionAsync("Styles")
        }
        else
        {
            <link href="~/content/base/styles.less" rel="stylesheet" type="text/css" />
        }
        <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
        </script>
    </head>
<body user-name="@userName" origin-url="@Url.Content("~/")">
        @await Component.InvokeAsync(nameof(LogOut), new { userName })

        <header>
            @await Component.InvokeAsync(nameof(Menu))
        </header>
        <section id="headline">
            @await RenderSectionAsync("Headline", false)
        </section>
        <section id="body" user-name="@userName" user-id="@userId">
            @RenderBody()
        </section>
        <div class="alert alert-success" id="msg-box" style="z-index: 9999;display:none;">
            <button type="button" class="close" data-dismiss="alert">
                &times;
            </button>
            <div class="alert-content">
            </div>
        </div>
        <div id="msg">
        </div>

        <script src="~/old-page/bundle/script-libs.js"></script>
        @await RenderSectionAsync("Scripts", false)
        @* <script src="~/js/sub-parlay-ticket.js"></script> *@

        <script src="~/nap-auth/re-checkin.js"></script>

    </body>
</html>