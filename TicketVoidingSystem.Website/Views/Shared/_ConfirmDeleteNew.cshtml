<fieldset id="fsConfirmDelete" class="form" style="display: none;">
    <legend>Confirmation</legend>
    <table class="tbl-confirm-delete">
        <tr>
            <td>
                <label for="reason">Reason (EN)</label>
            </td>
            <td>@Html.TextArea("reason", new { maxlength = "150", @class = "input-xlarge" })
            </td>
            <td>
                <span class="required">&nbsp;&nbsp;(*)</span> <span id="maxChar">Max 150 characters</span>
            </td>
        </tr>
        <tr>
            <td>
                <label for="reasonSC">Reason (SC)</label>
            </td>
            <td>@Html.TextArea("reasonSC", new { maxlength = "150", @class = "input-xlarge" })
            </td>
            <td>
                <span class="required">&nbsp;&nbsp;(*)</span> <span id="maxCharSC">Max 150 characters</span>
            </td>
        </tr>
        <tr>
            <td>
                <label for="username">Username</label>
            </td>
            <td>@Html.TextBox("username", ViewBag.UserName as string, new { autocomplete = "off", disabled = "disabled", @class = "input-medium" })
            </td>
            <td></td>
        </tr>
        <tr>
            <td>
                <label for="password">Password</label>
            </td>
            <td>@Html.Password("password", "", new { autocomplete = "new-password", @class = "input-medium" })
                <span class="required">&nbsp;&nbsp;(*)</span>
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <a class="submitMessage" id="btnVoidBet">Void Bet</a>
            </td>
        </tr>
    </table>
</fieldset>