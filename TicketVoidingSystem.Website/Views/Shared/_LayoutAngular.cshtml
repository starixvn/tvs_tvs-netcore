@using Fanex.NAP.Client.AspNetCore.Session
@{
    var session = new NapSession(httpContextAccessor);
    var userName = User?.Identity?.Name;
    var userId = session.UserId;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <base href="@Url.Content("~/")" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; Ticket Voiding System</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @await RenderSectionAsync("Head", false)
</head>
<body user-name="@userName" origin-url="@Url.Content("~/")" old-site-root-url="@Configuration["OldSiteRootUrl"]">
    <section id="body" user-name="@userName" user-id="@userId">
        @RenderBody()
    </section>

    @*<script type="text/javascript" src="~/js/NapTicketControl.js"></script>
        <script type="text/javascript" src="~/js/NapTicketControl.Helper.js"></script>
        <script type="text/javascript" src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>*@
</body>
</html>