@using Fanex.NAP.Client.AspNetCore.Session
@{
    var session = new NapSession(httpContextAccessor);
    var userName = User?.Identity?.Name;
    var userId = session.UserId;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <base href="@Url.Content("~/")" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; Ticket Voiding System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/favicon.ico" />
@*    <link rel="stylesheet" href="~/css/BetList.css" />*@
    @await RenderSectionAsync("Head", false)
</head>
<body user-name="@userName" root-url="@Url.Content("~/")" old-site-root-url="@Configuration["OldSiteRootUrl"]">
    <section id="body" user-name="@userName" user-id="@userId">
        @RenderBody()
    </section>
    <script src="~/js/SubParlayTicket.js"></script>
    <script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>
</body>
</html>