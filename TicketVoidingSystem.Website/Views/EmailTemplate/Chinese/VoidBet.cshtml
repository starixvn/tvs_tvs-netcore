@using RazorEngine.Text
@using TicketVoidingSystem.Utilities
<head>
    <style type="text/css">
        .auto-style1 {
            height: 23px;
        }

        .auto-style2 {
            width: 120px;
        }
    </style>
</head>
<table cellspacing="0" style="border: 1px solid; border-collapse: collapse; font-size: 12pt; font-family: 'Segoe UI',Tahoma,Arial,sans-serif; background-color: #E7F1F3">
    <tr height="70">
        <th style="background-color: #404C5A; color: #ffffff; text-transform: uppercase; padding-left: 10px; font-size: 20px; text-align: left;">注单作废信息 - Void bets information
        </th>
    </tr>
    <tr>
        <td style="padding: 0 0 10px 10px; border-bottom: 1 solid #CBCBCB;">
            <br />
            您好,<br />
            请注意以下列表是因为 <strong>@Model.VoidReasonSC</strong> 而所作废的注单摘要.<br />
            @if (!string.IsNullOrWhiteSpace(@Model.ChineseSimplified)) {
            <strong style="width: 1350px;">@Model.ChineseSimplified</strong>
            <br />
            }
            <br />
            Dear all,<br />
            Please be notified that the list in table below is the summary of all tickets which have been voided
            due to the reason of <strong>@Model.VoidReason</strong>.
            <br>
            @if (!string.IsNullOrWhiteSpace(@Model.English))
            {
            <strong style="width: 1350px;">@Model.English</strong>
            <br />
            }
            <br />
            日期 - Date: <strong>@Model.DateTime</strong>
            <br>
            @if (!string.IsNullOrEmpty(Model.NegativeBalanceUsers))
            {
            <span>出现负数帐号 - Negative Balance Customers: <strong style="background-color: yellow">@Model.NegativeBalanceUsers</strong>
            </span>
            <br>
            }
        </td>
    </tr>
    <tr style="border-bottom: 1px solid #CBCBCB; margin-top: 10px; margin-bottom: 10px;">
        <td class="auto-style1"></td>
    </tr>
    <tr>
        <td style="padding: 10px 0 0 10px;">
            @if (Model.Match != null)
            {
                <table cellspacing="1" style="background-color: #CBCBCB; font-size: 12pt;">
                    <tr align="Center" valign="Middle" style="background-color: #7891A5; font-weight: bold; text-transform: uppercase; color: #ffffff;">
                        <td width="80" height="30">
                            编码<br />
                            Code
                        </td>
                        @if (Helper.IsLikelyAbnormalBet(Model.IssueTypeId))
                        {
                            <td width="250">
                                联赛<br />
                                League
                            </td>
                        }
                        <td width="250">
                            赛事<br />
                            Event
                        </td>
                        <td width="80">
                            赛事日期<br />
                            Event Date
                        </td>
                    </tr>
                    <tr align="Center" valign="Middle" style="background-color: #ffffff; height: 30px; font-weight: bold;">
                        <td>
                            @Model.Match.MatchCode
                        </td>
                        @if (Helper.IsLikelyAbnormalBet(Model.IssueTypeId))
                        {
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Match.LeagueNameSimplified))
                                {
                                    @Model.Match.LeagueNameSimplified
                                    <br />
                                }
                                @if (!string.IsNullOrEmpty(Model.Match.LeagueNameNewSimplified))
                                {
                                    @Model.Match.LeagueNameNewSimplified
                                    <br />
                                }
                                @Model.Match.LeagueName
                            </td>
                        }
                        <td>
                            @if (!string.IsNullOrEmpty(Model.Match.MatchEventSimplified))
                            {
                                @Model.Match.MatchEventSimplified
                                <br />
                            }
                            @if (!string.IsNullOrEmpty(Model.Match.MatchEventNewSimplified))
                            {
                                @Model.Match.MatchEventNewSimplified
                                <br />
                            }
                            @Model.Match.MatchEvent
                        </td>
                        <td>
                            @Model.Match.EventDate.ToString("MM/dd/yyyy")
                        </td>
                    </tr>
                </table>
            }
            <br />
            @foreach (var group in Model.GroupTickets)
            {
                <strong>@group.Name</strong>
                <table cellspacing="1" style="background-color: #CBCBCB; font-size: 12pt;">
                    <tr align="Center" valign="Middle" style="background-color: #7891A5; font-weight: bold; color: #ffffff;">
                        <td width="25" height="25">
                            序號<br />
                            No
                        </td>
                        <td width="80">
                            注单号码<br />
                            Ref No
                        </td>
                        <td width="160">
                            交易时间<br />
                            Trans.Date
                        </td>
                        <td width="120">
                            会员<br />
                            Member<br />
                            (OperatorID)
                        </td>
                        <td width="120">
                            存款名<br />
                            Deposit Name
                        </td>
                        <td width="80">
                            盘口<br />
                            Bettype
                        </td>
                        <td width="80">
                            赔率<br />
                            Odds
                        </td>
                        <td class="auto-style2">
                            投注额<br />
                            Stake
                        </td>
                        <td width="70">
                            输赢<br />
                            WinLoss
                        </td>
                        <td width="50">
                            货币<br />
                            Currency
                        </td>
                        <td width="50">
                            状态<br />
                            Status
                        </td>
                        <td width="30">
                            比分<br />
                            Score
                        </td>
                        <td width="30">
                            让分<br />
                            HDP
                        </td>
                        <td width="300">
                            选择<br />
                            Choice
                        </td>
                        <td width="40">
                            注单来自<br />
                            Bet From
                        </td>
                    </tr>
                    @foreach (var ticket in group.Tickets)
                    {
                        var backgroundColor = @ticket.No % 2 == 0 ? "#E4F2FD" : "#FFFFFF";
                        <tr valign="Middle" style="background-color: @backgroundColor; height: 25px;">
                            <td align="Center">
                                @ticket.No
                            </td>
                            <td align="Center">
                                @(new RawString(ticket.BetId))
                            </td>
                            <td align="Center">
                                @ticket.TransDate
                            </td>
                            <td align="Center">
                                @if ((Helper.IsLikelyAbnormalBet(Model.IssueTypeId) || Helper.IsAbnormalAccount(Model.IssueTypeId)) && ticket.IsVipMember)
                                {
                                    <span style="color: red">@(new RawString(ticket.Member))</span>
                                }
                                else
                                {
                                    @(new RawString(ticket.Member))
                                }
                                @if (!string.IsNullOrEmpty(ticket.OperatorID))
                                {
                                    <br />
                                    @(new RawString("(" + @ticket.OperatorID + ")"))
                                }
                            </td>
                            <td align="Center">
                                @ticket.DepositName
                            </td>
                            <td align="Center">
                                @if (!string.IsNullOrEmpty(ticket.BetTypeSimplified))
                                {
                                    @(new RawString(@ticket.BetTypeSimplified))
                                    <br />
                                }
                                @(new RawString(@ticket.BetType))
                            </td>
                            <td align="Right">
                                @(new RawString(ticket.Odds))
                            </td>
                            <td align="Right" class="auto-style2">
                                @(new RawString(@ticket.Stake))
                            </td>
                            <td align="Right">
                                @ticket.WinLoss
                            </td>
                            <td align="Center">
                                @ticket.Currency
                            </td>
                            <td align="Center">
                                @(new RawString(ticket.Status))
                            </td>
                            <td align="Center">
                                @ticket.Score
                            </td>
                            <td align="Center">
                                @(new RawString(ticket.Handicap))
                            </td>
                            <td align="Right">
                                @(new RawString(ticket.Choice))
                            </td>
                            <td align="Center">
                                @ticket.BetFrom
                            </td>
                        </tr>
                    }
                </table>
                <br />
            }
            @if (Helper.IsLikelyAbnormalBet(Model.IssueTypeId) || Helper.IsAbnormalAccount(Model.IssueTypeId) || Model.IsFilterByUserName)
            {
                <p style="color: red">(*) VIP 会员以红色标注 - VIP Customer is highlighted in RED</p>
            }
            else
            {
                <br />
            }
            <br>
        </td>
    </tr>
    <tr>
        <td style="padding-left: 10px; background-color: #404C5A; color: #ffffff;" height="20">
            <em>此邮件为系统自动发出，请勿直接回复该邮件地址.</em>
            <br />
            <em>This is system auto generated email, please do not reply to this email directly.</em>
        </td>
    </tr>
</table>