<div class="filter-cell upload-batch-message">
    <input type="button" id="btnUpload" class="submit-update-batch" value="Upload Batch Message" data-ng-click="vm.updateBatchMessage($event)" />
</div>
<div class="filter-cell">
    <input type="button" id="btnClear" class="submit-update-batch" value="Clear Batch Message" data-ng-click="vm.clearMessage()" />
</div>
<div class="filter-cell">
    <input type="button" id="btnClearBetIDs" class="submit-update-batch" value="Clear BetID(s)" data-ng-click="vm.clearBetID()" />
</div>