namespace TicketVoidingSystem.Web
{
/// <summary>
/// Function keys.
/// </summary>
public static class SpecialDeleteFunctionKeys
{
<#
	SqlConnection conn = new SqlConnection(connectionString);

	string command = string.Format("SELECT DISTINCT FunctionKey from [NAP_Functions] INNER JOIN [NAP_Sites] on [NAP_Functions].SiteId=[NAP_Sites].SiteId WHERE SiteName='Special Delete' AND [NAP_Functions].IsActive = 1");

	SqlCommand comm = new SqlCommand(command, conn);

	conn.Open();

	SqlDataReader reader = comm.ExecuteReader();

	bool loop = reader.Read();

	while(loop)
	{#>public const string <#= reader["FunctionKey"].ToString() #> = "<#= reader["FunctionKey"].ToString() #>"<# loop = reader.Read(); #><#= loop ? ";" : ";" #>
<#}#>}
}
<#  
    reader.Close();
    conn.Close();
#>
