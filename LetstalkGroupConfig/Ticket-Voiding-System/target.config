<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="Push.Enabled" value="yes" />
    <add key="Push.To" value="" />

	<add key="Push.To.TVS-Notification-Letstalk-Test" value="10081066" />
	<add key="Push.To.TVS-Void-Settled-Bets" value="10081065" />
	<add key="Push.To.TVS-Void-Abnormal-Bets" value="10272233" />
	<add key="Push.To.TVS-Ticket-Listing-Alert" value="20102028" />
	<add key="Push.To.TVS-Abnormal-Bet-Request" value="20102030" />

    <add key="Push.Subject" value="{{Push.Subject}}" />
    <add key="Push.Template" value="template-push.txt" />
    <add key="Push.Notify" value="yes" />
  </appSettings>
</configuration>